# Copy to .env and fill in. Never commit .env or real credentials.
IOTDB_HOST=127.0.0.1
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=replace-me
IOTDB_CONNECTION_TIMEOUT_MS=5000

# Local runtime data (gitignored).
TSDB_OPTIMIZER_SQLITE_PATH=data/tsdb_optimizer.sqlite3
TSDB_OPTIMIZER_LOG_LEVEL=INFO
TSDB_OPTIMIZER_PREVIEW_ROWS=20
